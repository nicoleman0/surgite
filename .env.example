# Copy to .env and adjust, then run `docker compose up --build`.
# Every value here has a working default — the app runs with an empty .env.

# --- Database ---------------------------------------------------------------
# Compose starts Postgres with these and points the app at it. Change the
# password for anything beyond local use.
POSTGRES_USER=surgite
POSTGRES_PASSWORD=surgite
POSTGRES_DB=surgite

# --- AI summaries (optional) ------------------------------------------------
# The app works with NO key set: you still get formatted commit logs and
# non-AI summaries. Add a key only to enable AI-written prose summaries.
# Provider: anthropic | groq | deepseek | local
LLM_PROVIDER=anthropic

# --- Repository sync --------------------------------------------------------
# Number of repositories to sync concurrently. Set to 1 for serial syncs.
INGEST_CONCURRENCY=4
# Timeout for each Git clone, fetch, and log command.
GIT_TIMEOUT_SECONDS=120

# Only the provider selected above needs a key. Leave the others blank.
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEEPSEEK_API_KEY=

# Optional per-provider model overrides (sensible defaults are built in):
# ANTHROPIC_MODEL=claude-haiku-4-5-20251001
# GROQ_MODEL=llama-3.1-8b-instant
# DEEPSEEK_MODEL=deepseek-chat

# --- Self-hosted model (LLM_PROVIDER=local) ---------------------------------
# Any server speaking the OpenAI chat API: vLLM, Ollama, LM Studio, llama.cpp,
# LiteLLM. Point LOCAL_BASE_URL at the API root, NOT at /chat/completions --
# the app appends that. Ollama: http://host:11434/v1. vLLM: http://host:8000/v1.
# LOCAL_MODEL is optional. Left blank, the app asks the server what it serves
# (GET /models) and uses that -- which is the answer for a box serving one
# model. Set it if your server offers several, or to skip the lookup.
LOCAL_BASE_URL=
LOCAL_API_KEY=
# LOCAL_MODEL=

# Set this on a network that must not talk to a hosted provider. It drops
# anthropic/groq/deepseek from the registry at startup, so they can't be
# selected, can't have keys stored, and aren't probed by /health/deep.
# LLM_LOCAL_ONLY=1

# The hosted providers accept a base-URL override too, for a corporate proxy
# or an API gateway: ANTHROPIC_BASE_URL / GROQ_BASE_URL / DEEPSEEK_BASE_URL.

# Private CA on the internal endpoint? Point this at the bundle (mounted into
# the container). It REPLACES the public CA list rather than adding to it, so
# to keep a hosted provider working too, concatenate the two into one file.
# SSL_CERT_FILE=/etc/ssl/internal/ca-bundle.pem

# Git over HTTPS: TLS verification for every `git clone`/`fetch`/`ls-remote`
# the app performs. The shipped docker-compose verifies by default (0). If a
# git host uses a private CA, mount its bundle and set GIT_SSL_CAINFO instead
# of disabling verification:
#   GIT_SSL_CAINFO=/etc/ssl/internal/git-ca-bundle.pem
# Only set GIT_SSL_NO_VERIFY=1 as a last resort — it disables certificate
# verification for ALL git operations and every registered repo.
# GIT_SSL_NO_VERIFY=0

# --- Summary identity (optional) --------------------------------------------
# Injected into the AI prompt so summaries read in your voice.
SURGITE_USER=
SURGITE_ROLE=

# --- Auth (0.5.0) -----------------------------------------------------------
# AUTH_MODE selects how requests resolve to a user:
#   off         — anonymous; all data owned by the bootstrap user. The
#                 backward-compatible default; fine on a trusted network.
#   single_user — same single-user data model, but the auth machinery (session
#                 hashing) is active. No login UI.
#   multi_user  — full email+password session auth; /login + /logout exposed.
#                 Required to expose the app to people who aren't the operator.
#                 Requires HTTPS for browser sessions; terminate TLS in front of it.
AUTH_MODE=off

# The account that owns all data in off/single_user mode and the backfill
# target for the 0.4.0 -> 0.5.0 migration. On a multi_user first run the app
# logs an admin invite for this address (redeem with `surgite --redeem-invite`).
BOOTSTRAP_OWNER_EMAIL=owner@localhost

# Session lifetime / sliding-refresh threshold (days) and cleanup cadence (s).
# SESSION_TTL_DAYS=14
# SESSION_REFRESH_THRESHOLD_DAYS=7
# SESSION_CLEANUP_INTERVAL=3600

# Set DEBUG=true ONLY for local plain-HTTP dev: it drops the cookie's __Host-
# prefix and Secure flag so a browser will accept it over http://. Never in
# production.
# DEBUG=false

# --- At-rest encryption -----------------------------------------------------
# The Fernet master key that encrypts every user's provider API key in the
# database. Generate one with:
#
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#
# Set it for any deployment whose data you care about, and back it up: without
# it, the provider_keys rows in a database dump are unreadable ciphertext.
# SECRETS_ENCRYPTION_KEY=

# Left blank above, the app generates a key on first start and writes it here
# (chmod 600). Compose points this at the surgite-data volume on purpose — the
# default location is inside the image layer, so a key written there would be
# destroyed on the next redeploy along with access to every stored provider
# key. Change it only if you know the new path is durable.
# SECRETS_KEY_FILE=/var/surgite/data/.secrets_key

# Optional GitHub App repository picker. Register the app with read-only Contents
# permission and callback URL ${PUBLIC_URL}/connections/github/callback.
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=

# --- Advanced ---------------------------------------------------------------
# Host port to publish the app on (the container always listens on 8000).
API_PORT=8000

# Lifetime of a shared-summary link (the /s/<slug> URLs). Default 7 days.
# SHARE_TTL_DAYS=7

# --- Email (optional) -------------------------------------------------------
# Used for self-serve password reset (POST /auth/password-reset). Leave
# SMTP_HOST unset to use the logging mailer: the reset link is written to the
# log stream instead of sent, so reset still works before you configure mail.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587                 # 587 for STARTTLS, 465 for implicit TLS
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=surgite <no-reply@localhost>
# SMTP_TLS=starttls             # starttls | ssl | none
# Base URL used to build links in emails. Defaults to the request's origin.
# PUBLIC_URL=https://surgite.example.com

# --- CLI --registered mode (optional) ---------------------------------------
# `surgite --registered <name>` talks to a running API instead of a local
# clone. Point it at your instance. For a multi_user instance, authenticate
# with `surgite --login` (saves a session) or set a long-lived SURGITE_API_KEY.
# SURGITE_API_URL=http://localhost:8000
# SURGITE_API_KEY=

# Use the published image instead of building from source:
# APP_IMAGE=ghcr.io/nicoleman0/surgite:latest

# Running the API directly (not via compose)? Set the full DB URL instead of
# the POSTGRES_* vars above (note: localhost, not the compose "db" host):
# DATABASE_URL=postgresql://surgite:surgite@localhost:5432/surgite
